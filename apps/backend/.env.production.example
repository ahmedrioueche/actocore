# Production template — configure on the deployment host only.
PORT=3000
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=actocore_prod

# Studio dashboard URL (also added to CORS automatically)
STUDIO_APP_URL=https://www.actocore.pro
# Extra browser origins (comma-separated); STUDIO_APP_URL is always included
CORS_WEB_ORIGINS=https://www.actocore.pro,https://actocore.pro
CORS_SDK_ORIGINS=https://www.actocore.pro,https://actocore.pro
