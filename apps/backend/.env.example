# Server
PORT=3000
NODE_ENV=development
API_VERSION=v1

# MongoDB — one URL + one database name (use actocore_dev locally, actocore in prod)
#
#   docker compose -f compose.yml up -d
#   cp .env.example .env

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=actocore_dev

# Redis (default in development; omit or unset REDIS_URL in test)
REDIS_URL=redis://localhost:6379

# Chat quotas (enforced in production by default; set QUOTA_ENFORCE=true in dev to test)
# QUOTA_ENFORCE=false
# QUOTA_CHAT_PER_MINUTE=120
# QUOTA_CHAT_PER_DAY=5000
# QUOTA_CHAT_PER_MONTH=100000

# HTTP entry layer
CORS_SDK_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_WEB_ORIGINS=http://localhost:5173
HTTP_BODY_LIMIT_SDK=2mb
HTTP_BODY_LIMIT_WEB=1mb

# API key hashing (required in production)
# API_KEY_PEPPER=change-me-to-a-long-random-secret

# LLM provider: stub | openai | anthropic | google
LLM_PROVIDER=stub
# LLM_REQUEST_TIMEOUT_MS=120000

# OpenAI (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic / Claude (when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Embeddings for RAG (default: stub vectors; use openai with OPENAI_API_KEY)
# EMBEDDING_PROVIDER=stub
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini (when LLM_PROVIDER=google)
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash
