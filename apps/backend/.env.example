# Server
PORT=3000
NODE_ENV=development
API_VERSION=v1

# MongoDB — one URL + one database name (actocore_dev locally, actocore_prod in prod)
#
#   docker compose -f compose.yml up -d
#   cp .env.example .env

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=actocore_dev

# Redis — defaults to redis://localhost:6379 in development when unset.
# Disable locally (no Docker): REDIS_URL=
# REDIS_URL=redis://localhost:6379

# Chat quotas (enforced in production by default; set QUOTA_ENFORCE=true in dev to test)
# QUOTA_ENFORCE=false
# QUOTA_CHAT_PER_MINUTE=120
# QUOTA_CHAT_PER_DAY=5000
# QUOTA_TOKENS_PER_MONTH=10000000
# QUOTA_ALERT_PERCENTAGES=80,90,100

# HTTP entry layer (production: https://www.actocore.pro — STUDIO_APP_URL is auto-added to web CORS)
# When STUDIO_APP_URL is on actocore.pro, all subdomains are allowed automatically (*.actocore.pro).
CORS_SDK_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001
CORS_WEB_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001
# Optional extra wildcard patterns (comma-separated): https://*.actocore.pro or *.actocore.pro
# CORS_ORIGIN_PATTERNS=*.actocore.pro
HTTP_BODY_LIMIT_SDK=2mb
HTTP_BODY_LIMIT_WEB=1mb

# API key hashing (required in production)
# API_KEY_PEPPER=change-me-to-a-long-random-secret

# Platform super-admin (/v1/web/platform/*, /admin in Studio)
# STUDIO_PLATFORM_MASTER_EMAIL=platform-master@yourcompany.com
# STUDIO_PLATFORM_MASTER_PASSWORD=change-me-long-random-secret
# STUDIO_PLATFORM_ACCOUNT_NAME=ActoCore Platform

# Studio dashboard auth (/v1/web/auth/*)
# STUDIO_AUTH_DISABLED=true
# STUDIO_APP_URL=http://localhost:5173
# Production: STUDIO_APP_URL=https://www.actocore.pro
# STUDIO_AUTO_VERIFY_EMAIL=true
# STUDIO_JWT_SECRET=change-me-long-random-secret
# STUDIO_JWT_REFRESH_SECRET=change-me-long-random-refresh-secret
# STUDIO_PASSWORD_PEPPER=change-me-long-random-secret
# STUDIO_EMAIL_FROM=ActoCore Studio <noreply@actocore.pro>
# (alias: RESEND_EMAIL_FROM=noreply@actocore.pro — must match a verified Resend domain)
# RESEND_API_KEY=re_...
# STUDIO_DEFAULT_PROJECT_ON_SIGNUP=true
# STUDIO_DEFAULT_PROJECT_NAME=My project
# Feature flags (on by default in development; set false to disable)
# STUDIO_FEATURE_TEST_ACCOUNTS=false
# STUDIO_WEB_RATE_LIMIT_PER_MINUTE=120
# Without Resend/SMTP, verification links are logged to the console and returned in API
# responses (non-production) for local development.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/v1/web/auth/google/callback

# PayPal billing (Studio subscriptions — run npm run seed:paypal-catalog for plan IDs)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_RETURN_URL=http://localhost:5174/subscription
# PAYPAL_CANCEL_URL=http://localhost:5174/subscription
# PAYPAL_PRODUCT_ID=
# PAYPAL_PLAN_STARTER_MONTHLY=
# PAYPAL_PLAN_STARTER_YEARLY=
# PAYPAL_PLAN_PRO_MONTHLY=
# PAYPAL_PLAN_PRO_YEARLY=
# PAYPAL_PLAN_BUSINESS_MONTHLY=
# PAYPAL_PLAN_BUSINESS_YEARLY=

# LLM provider: stub | openai | anthropic | google
LLM_PROVIDER=stub
# LLM_REQUEST_TIMEOUT_MS=120000

# OpenAI (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic / Claude (when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Embeddings for RAG (independent of LLM_PROVIDER — chat can stay on google/anthropic)
# EMBEDDING_PROVIDER=stub
# EMBEDDING_PROVIDER=openai
# EMBEDDING_PROVIDER=google
#
# OpenAI embeddings:
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Google/Gemini embeddings (same key as chat):
# GEMINI_API_KEY=...
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# RAG retrieval tuning (hybrid vector + keyword scoring)
# RAG_TOP_K=4
# RAG_CANDIDATE_K=20
# RAG_HYBRID_KEYWORD_WEIGHT=0.3
# RAG_MIN_SCORE=0.12
# RAG_MIN_KEYWORD_SCORE=0.5
# RAG_CONTEXT_MAX_TOKENS=4000
# RAG_PAGE_BOOST=0.15

# Optional LLM query rewrite before retrieval (default off)
# RAG_QUERY_REWRITE=false
# RAG_QUERY_REWRITE=true

# Optional reranking after hybrid retrieval (improves Q&A ranking)
# RERANK_PROVIDER=none
# RERANK_PROVIDER=cohere
# COHERE_API_KEY=
# COHERE_RERANK_MODEL=rerank-english-v3.0

# Knowledge file storage (uploaded PDFs, text files)
# KNOWLEDGE_STORAGE_PATH=.data/knowledge
# KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
# URL HTML ingest: Mozilla Readability main-content extraction (default on)
# KNOWLEDGE_URL_READABILITY=false

# Sitemap crawl limits (type=sitemap knowledge sources)
# KNOWLEDGE_SITEMAP_MAX_PAGES=50
# KNOWLEDGE_SITEMAP_MAX_DEPTH=2
# KNOWLEDGE_SITEMAP_RATE_LIMIT_MS=500
# KNOWLEDGE_SITEMAP_FETCH_TIMEOUT_MS=15000

# Speech-to-text for SDK voice input (stub returns a demo phrase)
# VOICE_STT_PROVIDER=stub
# VOICE_STT_PROVIDER=openai
# VOICE_OPENAI_MODEL=whisper-1
# VOICE_MAX_AUDIO_BYTES=10485760

# Google Gemini (when LLM_PROVIDER=google)
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

# Public hero chat on marketing site (same project as Studio assistant — no API key in browser)
# Origins listed here are also added to CORS automatically.
# MARKETING_CHAT_ENABLED=true
# MARKETING_CHAT_PROJECT_ID=<studio-assistant-project-id>
# MARKETING_CHAT_ALLOWED_ORIGINS=http://localhost:3001,https://www.actocore.pro
# MARKETING_CHAT_RATE_LIMIT_PER_MINUTE=30

# Public web playground — per-visitor real projects (requires MARKETING_CHAT_* origins)
# PLAYGROUND_ENABLED=true
# PLAYGROUND_PROJECT_TTL_DAYS=7
# PLAYGROUND_MAX_BOOTSTRAP_PER_IP=5
# PLAYGROUND_SESSION_SECRET=<random-secret>
