# Public marketing site URL (canonical links)
VITE_SITE_URL=http://localhost:3001

# Studio app — sign in / get started CTAs
VITE_STUDIO_URL=http://localhost:5174

# Hero live chat (public marketing API routes — no API key in the browser)
VITE_ACTOCORE_API_URL=http://localhost:3000
VITE_MARKETING_CHAT_ENABLED=true

# Marketing hero project — seed once (ActoCore product docs for home chat only):
#   npm run setup:marketing-playground
# Playground visitors get their own projects via POST /v1/marketing/playground/bootstrap
# (requires backend PLAYGROUND_ENABLED=true and MARKETING_CHAT_*)

