{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ahmedrioueche/actocore-shared": ["../../packages/shared/dist/index.d.ts"],
      "@ahmedrioueche/actocore-shared/*": ["../../packages/shared/dist/*"],
      "@ahmedrioueche/actocore-sdk": ["../../packages/sdk/dist/index.d.ts"],
      "@ahmedrioueche/actocore-sdk/*": ["../../packages/sdk/dist/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/test"]
}
