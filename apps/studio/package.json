{
  "name": "actocore-studio",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "sync:brand": "node ./scripts/sync-brand-assets.mjs",
    "setup:assistant": "node ./scripts/seed-studio-assistant.mjs",
    "dev": "npm run sync:brand && vite",
    "build": "npm run sync:brand && npm run build --prefix ../../packages/shared && npm run build --prefix ../../packages/sdk && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ahmedrioueche/actocore-sdk": "file:../../packages/sdk",
    "@ahmedrioueche/actocore-shared": "0.0.31",
    "@sentry/react": "^10.58.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.132.47",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "i18next": "^25.5.2",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "react-tooltip": "^5.29.1",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
