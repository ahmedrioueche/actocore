VITE_ACTOCORE_API_URL=http://localhost:3000
# Sentry error monitoring (email alerts are configured in the Sentry dashboard)
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<project>
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_ENABLED=false
# Feature flags (on by default in dev; set false to disable)
# VITE_STUDIO_FEATURE_TEST_ACCOUNTS=false
# ActoCore product assistant (run: npm run setup:assistant after setting login below)
# STUDIO_SETUP_EMAIL=you@company.com
# STUDIO_SETUP_PASSWORD=your-studio-password
# VITE_ACTOCORE_API_KEY=
# VITE_ACTOCORE_ASSISTANT_PROJECT_ID=
# Optional legal page URLs (defaults to #)
# VITE_TERMS_URL=
# VITE_PRIVACY_URL=
