{
  "name": "@ahmedrioueche/actocore-sdk",
  "version": "0.0.2",
  "description": "Embeddable ActoCore chat SDK for React applications",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedrioueche/actocore.git",
    "directory": "packages/sdk"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "prepublishOnly": "npm run build",
    "publish:package": "npm publish --registry https://registry.npmjs.org --access public",
    "publish:public": "npm run publish:package",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ahmedrioueche/actocore-shared": "0.0.31",
    "i18next": "^25.5.2",
    "react-i18next": "^16.0.0",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
