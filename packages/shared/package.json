{
  "name": "@ahmedrioueche/actocore-shared",
  "version": "0.0.30",
  "description": "ActoCore API types, DTOs, and HTTP clients for backend, SDK, and Studio",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedrioueche/actocore.git",
    "directory": "packages/shared"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./dtos": {
      "types": "./dist/dtos/index.d.ts",
      "default": "./dist/dtos/index.js"
    },
    "./constants/knowledge-upload": {
      "types": "./dist/constants/knowledge-upload.d.ts",
      "default": "./dist/constants/knowledge-upload.js"
    },
    "./assets/actocore_icon.svg": "./assets/actocore_icon.svg",
    "./assets/actocore_logo.svg": "./assets/actocore_logo.svg"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "publish:package": "npm publish --registry https://registry.npmjs.org --access public",
    "publish:public": "npm run publish:package"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2"
  }
}
